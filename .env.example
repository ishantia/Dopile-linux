# Dopile Linux Configuration
APP_NAME=Dopile Linux
APP_ENV=production
DEBUG=false

HOST=0.0.0.0
PORT=8080

DATABASE_URL=sqlite:///./data/dopile.db

SECRET_KEY=change_me_to_a_random_32_character_string!
CSRF_SECRET=change_me_to_a_random_32_character_string!

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute

# Host Restrictions
# Set to false to allow logging in from remote devices across LAN
HOST_ONLY_LOGIN=false
